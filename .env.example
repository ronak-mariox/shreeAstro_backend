NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/shree_astro

# Signs the short-lived access token — REST calls and the socket handshake.
# How long it lasts (15m) is fixed in config/constants.js, not here.
JWT_SECRET=change-me

# Signs refresh tokens. Must differ from JWT_SECRET, so neither token can be
# presented where the other is expected. How long it lasts (30d) is fixed in
# config/constants.js, not here.
JWT_REFRESH_SECRET=change-me-too

# --- Login codes (OTP) ------------------------------------------------------
# Codes are stored in Redis with a TTL, so they expire on their own.
# The TTL, resend cooldown and max attempts are fixed in config/constants.js.

# Peppers the stored code hash. Without it a six-digit code is a million-guess
# lookup for anyone who gets hold of Redis.
OTP_SECRET=change-me-as-well

# TEMPORARY: no SMS or email provider is wired up yet, so this one code works
# for every login. It MUST be empty in production — the server refuses to boot
# otherwise. Delete it once a provider is plugged in.
OTP_MASTER_CODE=123456

# Comma-separated; "*" is fine while the apps are on Metro. Cookies need a real
# origin list once a browser client is involved.
CORS_ORIGINS=*

# Redis — must be the TCP connection string (rediss://... on Upstash), never
# the REST endpoint.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=shreeastro:

# --- Third-party integrations (admin panel's Third Parties tab) -------------
# Saving one on the panel writes its fields into THIS file, as
# INTEGRATION_<PROVIDER>_<FIELD> (e.g. INTEGRATION_AWS_S3_BUCKET,
# INTEGRATION_SMS_AUTH_KEY) plus an INTEGRATION_<PROVIDER>_ENABLED flag — see
# services/integrations.service.js. Nothing to fill in here by hand; this
# section exists so the pattern isn't a surprise the first time it happens.
# Only works when this file is actually writable, i.e. a real running server —
# not the Vercel serverless entry point (api/index.js), whose filesystem is
# read-only in production.

# Set in production so file URLs are absolute; derived from the request when blank.
PUBLIC_URL=

# --- AstrologyAPI.com --------------------------------------------------------
# Every kundli calculation comes from here; nothing is computed locally.
# Basic auth: username = user id, password = api key.
ASTROLOGY_API_USER_ID=
ASTROLOGY_API_KEY=
ASTROLOGY_API_BASE=https://json.astrologyapi.com/v1
# Fixed to 'lahiri' in practice — a different ayanamsha per call would make the
# planetary table and the chart image disagree.
ASTROLOGY_AYANAMSHA=lahiri
# Total calls (every endpoint combined) allowed per calendar month before the
# credit guard in services/kundliCache.service.js refuses with a clear error.
ASTROLOGY_API_MONTHLY_LIMIT=150
# Schedules jobs/horoscopePrefetch.job.js's daily 00:05 IST cron (see index.js)
# when true — leave false in a low-credit dev environment, since that job
# alone can spend up to 12 credits a night on its own.
HOROSCOPE_PREFETCH_ENABLED=false

# --- AI astrology assistant --------------------------------------------------
# Blank until a provider is actually wired up (services/llm/index.js) — the
# assistant refuses with a clear error rather than silently picking one.
# Only 'groq' exists today (free tier, OpenAI-compatible); 'openai' is the
# planned swap once there's budget for it — see services/llm/groq.js's own
# header comment for why the same api key/model vars carry over unchanged.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# How many turns accumulate before the oldest chunk is folded into the
# session's rolling summary.
SUMMARISE_AFTER_MESSAGES=15
# Prior-message budget per request, in estimated tokens (utils/tokens.js) —
# not the model's own context limit, just what this app chooses to spend.
CONTEXT_TOKEN_BUDGET=2000
# How long the AI assistant's own conversation context (messages, and its
# rolling summary) lives in Mongo before MongoDB's own TTL indexes remove it
# — see models/Chat.js's `chatType` TTL index and models/AssistantMemory.js.
# No cron: this only sets what a newly-built index uses: changing it later
# does not retroactively rewrite an index already created with the old value
# on a running deployment (see this feature's migration note).
CHAT_MESSAGE_RETENTION_DAYS=7
# Reserved — nothing sets an AI thread to expired today; the line above's TTL
# indexes handle the assistant's own retention without needing this.
SESSION_IDLE_EXPIRY_DAYS=10
# Per user message — stops a confused model from looping on the same tool.
MAX_TOOL_CALLS_PER_MESSAGE=3
