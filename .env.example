NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/shree_astro

# Signs the short-lived access token — REST calls and the socket handshake.
# How long it lasts (15m) is fixed in config/constants.js, not here.
JWT_SECRET=change-me

# Signs refresh tokens. Must differ from JWT_SECRET, so neither token can be
# presented where the other is expected. How long it lasts (30d) is fixed in
# config/constants.js, not here.
JWT_REFRESH_SECRET=change-me-too

# --- Login codes (OTP) ------------------------------------------------------
# Codes are stored in Redis with a TTL, so they expire on their own.
# The TTL, resend cooldown and max attempts are fixed in config/constants.js.

# Peppers the stored code hash. Without it a six-digit code is a million-guess
# lookup for anyone who gets hold of Redis.
OTP_SECRET=change-me-as-well

# TEMPORARY, AND IN USE IN PRODUCTION: one code that signs in as ANY account,
# standing in for real OTP delivery until MSG91 credentials arrive. The server
# boots with it and warns about it on every start.
#
# While it is switched on it is effectively one password for the whole system,
# so: set it to six digits nobody would try first — NOT 123456, which is the
# first thing anyone guesses — and delete it the day SMS or email delivery
# works. Guessing is capped from both sides meanwhile (ten guesses per phone
# number per 15 minutes in services/otp.service.js, plus a per-caller ceiling
# on the sign-in endpoints), which only holds up if the value itself is not an
# obvious one.
#
# Unset in production with no provider configured, nobody can sign in at all.
OTP_MASTER_CODE=123456

# Comma-separated; "*" is fine while the apps are on Metro. Cookies need a real
# origin list once a browser client is involved.
CORS_ORIGINS=*

# Redis — must be the TCP connection string (rediss://... on Upstash), never
# the REST endpoint.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=shreeastro:

# --- Third-party integrations (admin panel's Third Parties tab) -------------
# Saving one on the panel writes its fields into THIS file, as
# INTEGRATION_<PROVIDER>_<FIELD> (e.g. INTEGRATION_AWS_S3_BUCKET,
# INTEGRATION_SMS_AUTH_KEY) plus an INTEGRATION_<PROVIDER>_ENABLED flag — see
# services/integrations.service.js. Nothing to fill in here by hand; this
# section exists so the pattern isn't a surprise the first time it happens.
# Only works when this file is actually writable, i.e. a real running server —
# not the Vercel serverless entry point (api/index.js), whose filesystem is
# read-only in production. Where it isn't writable, set the same variables as
# real deployment environment variables instead.
#
# WHAT REPLACES THE MASTER CODE: a login code only reaches a real person once
# SMS or email delivery is configured — until then it is written to the server
# log and nowhere else, which is the whole reason OTP_MASTER_CODE above is
# still on. Configure this, then unset that. For MSG91:
#
#   INTEGRATION_SMS_ENABLED=true
#   INTEGRATION_SMS_AUTH_KEY=...
#   INTEGRATION_SMS_TEMPLATE_ID=...
#   INTEGRATION_SMS_SENDER_ID=...      (optional)
#
# Delivery itself stays best-effort: a failed send never breaks a login request,
# it just means that code never arrives (see services/otp.service.js).

# Set in production so file URLs are absolute; derived from the request when blank.
PUBLIC_URL=

# --- AstrologyAPI.com --------------------------------------------------------
# Every kundli calculation comes from here; nothing is computed locally.
# Basic auth: username = user id, password = api key.
ASTROLOGY_API_USER_ID=
ASTROLOGY_API_KEY=
ASTROLOGY_API_BASE=https://json.astrologyapi.com/v1
# Fixed to 'lahiri' in practice — a different ayanamsha per call would make the
# planetary table and the chart image disagree.
ASTROLOGY_AYANAMSHA=lahiri
# Total calls (every endpoint combined) allowed per calendar month before the
# credit guard in services/kundliCache.service.js refuses with a clear error.
ASTROLOGY_API_MONTHLY_LIMIT=150
# The daily horoscope prefetch's own separate monthly ceiling. 12 signs x up to
# 31 days is 372 calls on its own, so it is deliberately NOT drawn from the
# limit above — sharing one pool would let a month of prefetching starve every
# new kundli of credits for the rest of the month.
HOROSCOPE_API_MONTHLY_LIMIT=400
# Schedules jobs/horoscopePrefetch.job.js's daily 00:05 IST cron (see index.js)
# when true — leave false in a low-credit dev environment, since that job
# alone can spend up to 12 credits a night on its own.
HOROSCOPE_PREFETCH_ENABLED=false

# --- AI astrology assistant --------------------------------------------------
# Blank until a provider is actually wired up (services/llm/index.js) — the
# assistant refuses with a clear error rather than silently picking one.
# Only 'groq' exists today (free tier, OpenAI-compatible); 'openai' is the
# planned swap once there's budget for it — see services/llm/groq.js's own
# header comment for why the same api key/model vars carry over unchanged.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# How many turns accumulate before the oldest chunk is folded into the
# session's rolling summary.
SUMMARISE_AFTER_MESSAGES=15
# Prior-message budget per request, in estimated tokens (utils/tokens.js) —
# not the model's own context limit, just what this app chooses to spend.
CONTEXT_TOKEN_BUDGET=2000
# How long the AI assistant's own conversation context (messages, and its
# rolling summary) lives in Mongo before MongoDB's own TTL indexes remove it
# — see models/Chat.js's `chatType` TTL index and models/AssistantMemory.js.
# No cron: this only sets what a newly-built index uses: changing it later
# does not retroactively rewrite an index already created with the old value
# on a running deployment (see this feature's migration note).
CHAT_MESSAGE_RETENTION_DAYS=7
# Reserved — nothing sets an AI thread to expired today; the line above's TTL
# indexes handle the assistant's own retention without needing this.
SESSION_IDLE_EXPIRY_DAYS=10
# Per user message — stops a confused model from looping on the same tool.
MAX_TOOL_CALLS_PER_MESSAGE=3

# --- Consultation billing and timing -----------------------------------------
# Real money and a running clock: these defaults ARE the designed behaviour
# (see config/constants.js and utils/billing.js), so change them deliberately.

# A part-minute counts as a whole one; the wallet must cover at least this many
# minutes before a consultation may start.
MIN_BALANCE_MINUTES=1
PARTIAL_MINUTE_ROUNDING=up
# How long before a minute falls due the seeker is warned they cannot afford
# the next one, and how long after a due minute the session is given before it
# is treated as unpaid.
CHECK_AHEAD_SECONDS=40
GRACE_PERIOD_SECONDS=15
# How long an accepted session waits for the astrologer to actually join before
# it is ended (and the seeker's opening minute refunded), and how long a
# dropped astrologer has to come back before the session is paused for free.
ASTROLOGER_JOIN_TIMEOUT_SECONDS=120
ASTROLOGER_RECONNECT_GRACE_SECONDS=60
# How long an active consultation waits after the SEEKER's app disappears —
# closed, killed, or off the network — before it is ended. Not a pause: the
# session ends, billed only up to the moment they went. The wait is there because
# a dropped socket cannot tell "closed the app" from "walked through a tunnel",
# and ending a paid consultation over a blink is worse than waiting to be sure.
USER_RECONNECT_GRACE_SECONDS=45
# Seconds before a package runs out that the seeker is warned it is ending
# (config/packages.js; the durations and discounts themselves are not env vars
# — durations live in that file, discounts are set on the admin panel).
PACKAGE_WARNING_SECONDS=30
# The "busy for about N minutes" estimate shown against an astrologer already
# in a consultation, used only until they have consultations of their own to
# average.
ESTIMATED_CONSULTATION_MINUTES=10

# --- Wallet top-ups without a payment gateway --------------------------------
# There is no gateway wired up: services/wallet.service.js opens a pending
# top-up and then credits the wallet, with nothing in between verifying that
# anyone actually paid. In production that is free money — and it is spent on
# consultations that pay astrologers real rupees — so that path is CLOSED in
# production unless this is explicitly set to true.
#
# Closed, a seeker is told recharge is unavailable, and an admin can still
# credit a wallet by hand (the panel's Wallets tab) for money collected another
# way. Wire a real gateway into the gap between startTopUp and confirmTopUp,
# then delete this.
ALLOW_UNVERIFIED_TOPUPS=false

# --- Jobs on a host that cannot hold timers ----------------------------------
# index.js runs the billing sweep itself, every 10 seconds, and on such a host
# this stays blank — which leaves the endpoint below switched off entirely.
#
# The Vercel serverless entry (api/index.js) has no persistent process: with
# nothing calling in, a consultation is billed its opening minute and then
# never again, and a package session never reaches its end (no warning, no
# continue choice, no settle). Set a long random value and point a scheduler at
#
#   POST /api/v1/internal/billing/sweep
#   x-internal-key: <this value>        (or Authorization: Bearer <this value>)
#
# as often as it allows. Calling it more than once for the same minute is safe —
# the ChatBillingTick ledger's unique index means a minute already billed
# cannot be billed twice. Note this only covers billing: websockets cannot run
# there at all, so live chat needs a persistent host regardless.
INTERNAL_API_KEY=
