NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/shree_astro

# Signs REST tokens and the one a socket hands over on connect.
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Comma-separated; "*" is fine while the apps are on Metro.
CORS_ORIGINS=*

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Set in production so file URLs are absolute; derived from the request when blank.
PUBLIC_URL=
