NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/shree_astro

# Signs the short-lived access token — REST calls and the socket handshake.
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m

# Signs refresh tokens. Must differ from JWT_SECRET, so neither token can be
# presented where the other is expected.
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=30d

# --- Login codes (OTP) ------------------------------------------------------
# Codes are stored in Redis with a TTL, so they expire on their own.

# Peppers the stored code hash. Without it a six-digit code is a million-guess
# lookup for anyone who gets hold of Redis.
OTP_SECRET=change-me-as-well

# TEMPORARY: no SMS or email provider is wired up yet, so this one code works
# for every login. It MUST be empty in production — the server refuses to boot
# otherwise. Delete it once a provider is plugged in.
OTP_MASTER_CODE=123456

OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Auth cookies. Defaults suit development (same-origin, http); in production
# the panel is cross-site, which needs SameSite=None and therefore HTTPS.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_REFRESH_PATH=/api/v1/auth

# Comma-separated; "*" is fine while the apps are on Metro. Cookies need a real
# origin list once a browser client is involved.
CORS_ORIGINS=*

# Redis — must be the TCP connection string (rediss://... on Upstash), never
# the REST endpoint.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=shreeastro:

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Set in production so file URLs are absolute; derived from the request when blank.
PUBLIC_URL=
